# Local credentials (keep shareable configuration templates visible).
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Python environments and caches.
.venv/
venv/
env/
ENV/
.virtualenv/
__pycache__/
*.pyc
.pytest_cache/

# Local editor settings and input downloads.
.vscode/
data/raw/

# Generated results, checkpoints, response logs, sessions and audit artifacts.
# Keep directories traversable so Python source, notebooks and docs stay visible.
/results/**
!/results/**/
!/results/**/*.py
!/results/**/*.ipynb
!/results/**/*.md
/outputs/**
!/outputs/**/
!/outputs/**/*.py
!/outputs/**/*.ipynb
!/outputs/**/*.md
/experiments/**/mock_logs/**
!/experiments/**/mock_logs/**/
!/experiments/**/mock_logs/**/*.py

# Temporary persistence files and runtime logs.
*.tmp
*.tmp.*
*.log
